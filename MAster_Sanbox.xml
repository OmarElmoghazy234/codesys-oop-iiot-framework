                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
                    <Method name="CyclicUpdate" ObjectId="e1123608-419c-42ee-b611-5af4fed4653e">
                      <interface />
                      <body>
                        <ST>
                          <xhtml xmlns="http://www.w3.org/1999/xhtml">// Execute the parent timer logic first
SUPER^.CyclicUpdate();

// Add motor-specific speed ramping
IF _bRunning AND (_rActualSpeed &lt; _rTargetSpeed) THEN
    _rActualSpeed := _rActualSpeed + 25.0;
ELSIF NOT _bRunning AND (_rActualSpeed &gt; 0.0) THEN
    _rActualSpeed := _rActualSpeed - 50.0;
END_IF
</xhtml>
                        </ST>
                      </body>
                      <addData />
                    </Method>
                  </data>
