                      </type>
                    </variable>
                    <variable name="aActuators">
                      <type>
                        <array>
                          <dimension lower="1" upper="3" />
                          <baseType>
                            <derived name="I_Actuator" />
                          </baseType>
                        </array>
                      </type>
                      <initialValue>
                        <arrayValue>
                          <value>
                            <simpleValue value="fbConveyorMotor" />
                          </value>
                          <value>
                            <simpleValue value="fbCoolingPump" />
                          </value>
                          <value>
                            <simpleValue value="fbMainValve" />
                          </value>
                        </arrayValue>
                      </initialValue>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Polymorphic Interface Array</xhtml>
                      </documentation>
                    </variable>
                    <variable name="bStartAll">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Master Control Triggers</xhtml>
                      </documentation>
                    </variable>
                    <variable name="bStopAll">
                      <type>
                        <BOOL />
                      </type>
                    </variable>
                    <variable name="i">
                      <type>
                        <INT />
                      </type>
                    </variable>
                    <variable name="fbTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> 1-second pulse generator</xhtml>
                      </documentation>
                    </variable>
                    <variable name="fbLogTimer">
                      <type>
                        <derived name="TON" />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> 60-second log pulse generator</xhtml>
                      </documentation>
                    </variable>
                    <variable name="bResetUptime">
                      <type>
                        <BOOL />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Manual flag to reset stats if needed</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                  <localVars retain="true" persistent="true">
                    <variable name="udiTotalSeconds">
                      <type>
                        <UDINT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Cumulative uptime in seconds</xhtml>
                      </documentation>
                    </variable>
                    <variable name="udiTotalMinutes">
                      <type>
                        <UDINT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Cumulative uptime in minutes</xhtml>
                      </documentation>
                    </variable>
                    <variable name="udiSaveCount">
                      <type>
                        <UDINT />
                      </type>
                      <documentation>
                        <xhtml xmlns="http://www.w3.org/1999/xhtml"> Tracks how many times a log entry was saved</xhtml>
                      </documentation>
                    </variable>
                  </localVars>
                </interface>
                <body>
                  <ST>
                    <xhtml xmlns="http://www.w3.org/1999/xhtml">// 1. Generate a 1-Second Heartbeat Pulse
fbTimer(IN := NOT fbTimer.Q, PT := T#1S);

IF fbTimer.Q THEN
    udiTotalSeconds := udiTotalSeconds + 1;
END_IF

// 2. Generate a 60-Second Pulse for Persistent Logging
fbLogTimer(IN := NOT fbLogTimer.Q, PT := T#60S);

IF fbLogTimer.Q THEN
    udiTotalMinutes := udiTotalMinutes + 1;
    udiSaveCount    := udiSaveCount + 1; // Tracks every successful minute saved
END_IF

// 3. Optional Debug Reset Flag
IF bResetUptime THEN
    udiTotalSeconds := 0;
    udiTotalMinutes := 0;
    udiSaveCount    := 0;
    bResetUptime    := FALSE;
END_IF


// Master Start Command across completely different device types
IF bStartAll THEN
    FOR i := 1 TO 3 DO
        aActuators[i].Start();
    END_FOR
    bStartAll := FALSE;
END_IF

// Master Stop Command
IF bStopAll THEN
    FOR i := 1 TO 3 DO
        aActuators[i].Stop();
    END_FOR
    bStopAll := FALSE;
END_IF

// Cyclic execution for all registered actuators
FOR i := 1 TO 3 DO
    aActuators[i].CyclicUpdate();
END_FOR</xhtml>
                  </ST>
                </body>
